<?xml version="1.0" encoding="UTF-8"?>
<!--
  PMD 门禁包装工程模板。装配步骤见 java-contract 技能「门禁」一节：
  1. 复制到 <项目根>/.qualitygate/pmd-pom.xml
  2. 复制同目录的 pmd7-ruleset.xml 到 <项目根>/.qualitygate/pmd7-ruleset.xml
  3. maven.compiler.release 改成项目实际 JDK 版本
  4. compileSourceRoots 每个源码根一行，路径必须相对 ${project.basedir}
  5. .gitignore 只追加 .qualitygate/target/（pom 与规则集要入库）

  门禁：mvn -f .qualitygate/pmd-pom.xml pmd:check -B   接 CI，不装 git hook
  体检：mvn -f .qualitygate/pmd-pom.xml pmd:pmd -q     读 .qualitygate/target/pmd.xml
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>local.qualitygate</groupId>
    <artifactId>qualitygate-pmd</artifactId>
    <version>1.0.0</version>
    <!-- 必须是 jar：pom 打包时 PMD 插件跳过源码扫描 -->
    <packaging>jar</packaging>

    <properties>
        <!-- 等于项目实际版本；低于代码语法版本会报 ParseException -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.27.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>${project.basedir}/pmd7-ruleset.xml</ruleset>
                    </rulesets>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <format>xml</format>

                    <!-- 阻断阈值：1 只拦 Blocker，2 同时拦 Critical。
                         默认 1。2 需要先治理存量：实测 965 文件的 JDK8 项目 P<=2 有 18 条、
                         5235 文件的 JDK17 项目有 40 条，直接启用会让首次构建全红。
                         3 及以上是 warning，全拦不可用（p3 通常数百条）。 -->
                    <failurePriority>1</failurePriority>
                    <!-- 有违规就让 pmd:check 退出码为 1，CI 据此判流水线失败 -->
                    <failOnViolation>true</failOnViolation>
                    <!-- 失败时把每条违规打到控制台（类名:行 规则 消息），不用读 XML -->
                    <printFailingErrors>true</printFailingErrors>
                    <!-- false：解析失败时中止并打印 ParseException，避免静默漏检 -->
                    <skipPmdError>false</skipPmdError>

                    <!-- 每个源码根一行，路径相对本 pom 所在目录。
                         参数名必须是 compileSourceRoots：写成 sourceDirectories
                         不报错，但会静默扫 0 个文件。单模块保留下面一行即可。 -->
                    <compileSourceRoots>
                        <compileSourceRoot>${project.basedir}/../src/main/java</compileSourceRoot>
                        <!-- 多模块逐个补齐，例如：
                        <compileSourceRoot>${project.basedir}/../mall-admin/src/main/java</compileSourceRoot>
                        <compileSourceRoot>${project.basedir}/../mall-portal/src/main/java</compileSourceRoot>
                        -->
                    </compileSourceRoots>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
