#!/bin/sh
# jdk-rules 门禁：提交前跑 PMD 7，priority 达到阻断阈值的违规会中止本次提交。
# 违规明细由 pmd:check 直接打到控制台（类名:行 规则 消息），本脚本不做任何报告解析。
#
# 安装：git config core.hooksPath .qualitygate/hooks
# 跳过：git commit --no-verify，或 JAVA_STANDARD_GATE=off git commit ...
# 仓库已有其他 hook 时不要用 core.hooksPath，改为在本脚本外由原 hook 追加一行调用。

[ "$JAVA_STANDARD_GATE" = "off" ] && exit 0

root=$(git rev-parse --show-toplevel) || exit 0
[ -f "$root/.qualitygate/pmd-pom.xml" ] || exit 0

# 本次提交没有 Java 改动就不跑（PMD 全量约 5s / 500 文件）
git -C "$root" diff --cached --name-only --diff-filter=ACM -- '*.java' | grep -q . || exit 0

cd "$root" || exit 0
# mvn 的退出码即 hook 的退出码：非 0 时 git 中止本次提交
mvn -f .qualitygate/pmd-pom.xml pmd:check -B
